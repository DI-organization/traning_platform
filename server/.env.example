# PostgreSQL connection string (Neon). Use the pooled connection for the app
# and the direct/unpooled connection for migrations if your Prisma version needs it.
DATABASE_URL=""
# Uncomment if using Prisma < 5.10 or running migrations against Neon's pooler
# DATABASE_URL_UNPOOLED=""

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Optional. Raises GitHub public API rate limits. Not required for basic use.
GITHUB_TOKEN=""

CLIENT_URL="http://localhost:5174"
PORT=5000
NODE_ENV=development

# Optional. Overrides the seeded trainer account's email/password (defaults
# to the trainer@example.com demo account if unset). Set these locally to
# seed your own real trainer login instead of the shared demo one — never
# commit real values here.
SEED_TRAINER_EMAIL=""
SEED_TRAINER_PASSWORD=""
